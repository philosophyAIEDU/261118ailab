{
  "name": "philosophy-research-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "교수님만의 AI 연구실 (Philosophy Research Hub) — 필로소피 AI 교육",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs.cjs && tsc --noEmit && vite build",
