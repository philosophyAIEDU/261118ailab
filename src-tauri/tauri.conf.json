{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "교수님만의 AI 연구실",
  "mainBinaryName": "philosophy-research-hub",
  "version": "0.1.0",
  "identifier": "kr.philosophy-ai.research-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "교수님만의 AI 연구실",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../demo/papers/": "demo/"
    },
    "category": "Education",
    "publisher": "필로소피 AI 교육",
    "shortDescription": "교수님의 논문과 연구자료를 모으고, 검색하고, 비교하고, 연결하세요.",
    "longDescription": "교수님만의 AI 연구실(Philosophy Research Hub)은 논문과 연구자료를 내 컴퓨터에 축적하고 로컬 AI로 검색·비교·분석·연결하는 연구 프로그램입니다. 개발 및 제공: 필로소피 AI 교육.",
    "copyright": "© 2026 필로소피 AI 교육 (Philosophy AI Education)",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/philosophyAIEDU/261118ailab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}